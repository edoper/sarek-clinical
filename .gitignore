# ─────────────────────────────────────────────────────────────────────────
# ALLOW-LIST .gitignore — ignore everything, then un-ignore only code/config.
# This pipeline touches patient data (CRAM paths, sample/family IDs, VCFs).
# Ignoring by default makes it impossible to commit PHI by accident. Keep private.
# To track a new code/config file, add an explicit "!<file>" below.
# ─────────────────────────────────────────────────────────────────────────

# Ignore everything by default
*

# Shared core
!.gitignore
!CLAUDE.md
!README.md
!BGE.md
!LICENSE
!consensus.sh
!env.sh
!site.sh
!qc_gate.sh

# WGS-from-FASTQ entry point
!gcb.config
!gcb-smoke.config
!samplesheet.example.csv

# BGE-exome-from-CRAM entry point
!gcb-bge-wes.config
!build_cohort.py
!make_samplesheet.sh
!run_bge_wes.sh
!consensus_from_results.sh
!run_bge_annotate_filter.sh
!bge_progress.sh
!bge_filter_progress.sh
!bge_cost.sh
!bge_dashboard.sh
!families.example.tsv

# Exome-from-FASTQ entry point (align + call; e.g. EPIGEN)
!run_epigen_wes.sh
!upload_epigen_fastq.sh

# Tests (synthetic data only — generated at runtime into a temp dir, never committed)
!test/
!test/test_consensus.sh
!test/test_qc_gate.sh

# GIAB validation harness + results (HG002 is a PUBLIC reference sample, not a patient,
# so its accuracy numbers are publishable — that is the point of a validation).
# The bulk data it downloads (truth/, *.sdf, consensus/, rtg-tools/) stays ignored.
!validation/
!validation/README.md
!validation/run_giab.sh
!validation/benchmark_giab.sh
!validation/health_check.sh
!validation/RESULTS-HG002.md
!validation/RESULTS-HG002-EXOME.md
!validation/SOP.md
!validation/EFFICIENCY.md
!validation/orchestrate_exome.sh
!validation/run_giab_exome.sh
!validation/split_metrics.sh

# Explicitly NEVER tracked (covered by "*", here as documentation):
#   samplesheet.csv  families.tsv             <- real inputs (patient IDs / gs:// CRAM paths)
#   consensus/  *.vcf  *.vcf.gz  *.tbi         <- patient variants
#   work/  results/  .nextflow*  *.html  *.log  null/   <- run artifacts
#   site.env                                   <- YOUR project/bucket/paths (see site.sh)
